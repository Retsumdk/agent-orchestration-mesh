{
  "name": "agent-orchestration-mesh",
  "description": "Service mesh for AI agents: discovery, load balancing, circuit breaking, and mutually authenticated encrypted channels",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "agents",
    "ai-agents",
    "orchestration",
    "service-mesh",
    "service-discovery",
    "load-balancer",
    "circuit-breaker",
    "encryption"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "agent-mesh": "./dist/cli.js"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "demo": "bun run src/cli.ts demo"
  },
  "devDependencies": {
    "bun-types": "^1.2.21",
    "typescript": "^5.3.0"
  }
}
